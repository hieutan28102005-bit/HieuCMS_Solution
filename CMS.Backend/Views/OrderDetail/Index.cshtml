@model List<CMS.Data.Entities.OrderDetail>

<h1>DANH SÁCH CHI TIẾT ĐƠN HÀNG</h1>

<table border="1" cellpadding="10">

    <tr>
        <th>ID</th>
        <th>Số lượng</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>

            <td>@item.Id</td>

            <td>@item.Quantity</td>

        </tr>
    }

</table>