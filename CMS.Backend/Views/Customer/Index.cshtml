@model List<CMS.Data.Entities.Customer>

<h1>DANH SÁCH KHÁCH HÀNG</h1>

<table border="1" cellpadding="10">

    <tr>
        <th>ID</th>
        <th>Họ tên</th>
        <th>Email</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>

            <td>@item.Id</td>

            <td>@item.FullName</td>

            <td>@item.Email</td>

        </tr>
    }

</table>