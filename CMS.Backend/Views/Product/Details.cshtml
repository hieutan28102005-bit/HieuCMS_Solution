@model CMS.Data.Entities.Product

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<div class="card-custom">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary me-3">
            <i class="fas fa-arrow-left"></i> Quay lại
        </a>
        <div>
            <h2 class="text-primary mb-0">
                <i class="fas fa-info-circle"></i> Chi tiết sản phẩm
            </h2>
            <p class="text-muted mt-1">Thông tin chi tiết sản phẩm #@Model.Id</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <table class="table table-bordered">
                <tr>
                    <th style="width: 150px;">ID</th>
                    <td>@Model.Id</td>
                </tr>
                <tr>
                    <th>Tên sản phẩm</th>
                    <td><strong>@Model.Name</strong></td>
                </tr>
                <tr>
                    <th>Giá</th>
                    <td class="text-danger fw-bold">@String.Format("{0:N0} VNĐ", Model.Price)</td>
                </tr>
                <tr>
                    <th>Số lượng tồn kho</th>
                    <td>
                        @if (Model.StockQuantity <= 0)
                        {
                            <span class="badge bg-danger">Hết hàng</span>
                        }
                        else if (Model.StockQuantity <= 5)
                        {
                            <span class="badge bg-warning">Còn @Model.StockQuantity</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Còn @Model.StockQuantity</span>
                        }
                    </td>
                </tr>
            </table>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <i class="fas fa-image"></i> Hình ảnh sản phẩm
                </div>
                <div class="card-body text-center">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" class="img-fluid rounded" style="max-height: 300px;" />
                    }
                    else
                    {
                        <div class="text-muted py-5">
                            <i class="fas fa-image fa-4x mb-3"></i>
                            <p>Chưa có hình ảnh</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <i class="fas fa-align-left"></i> Mô tả sản phẩm
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <p>@Model.Description</p>
                    }
                    else
                    {
                        <p class="text-muted">Chưa có mô tả cho sản phẩm này.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
            <i class="fas fa-edit"></i> Sửa
        </a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
            <i class="fas fa-trash"></i> Xóa
        </a>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-list"></i> Quay lại danh sách
        </a>
    </div>
</div>