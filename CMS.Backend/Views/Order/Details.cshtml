@model CMS.Data.Entities.Order

@{
    ViewData["Title"] = "Chi tiết đơn hàng";
}

<div class="card-custom">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary me-3">
            <i class="fas fa-arrow-left"></i> Quay lại
        </a>
        <div>
            <h2 class="text-primary mb-0">
                <i class="fas fa-receipt"></i> Chi tiết đơn hàng #@Model.Id
            </h2>
            <p class="text-muted mt-1">Thông tin đơn hàng và sản phẩm</p>
        </div>
    </div>

    <!-- Thông tin đơn hàng -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <i class="fas fa-info-circle"></i> Thông tin đơn hàng
                </div>
                <div class="card-body">
                    <table class="table table-borderless">
                        <tr>
                            <th style="width: 120px;">Mã đơn:</th>
                            <td>#@Model.Id</td>
                        </tr>
                        <tr>
                            <th>Ngày đặt:</th>
                            <td>@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                        <tr>
                            <th>Trạng thái:</th>
                            <td>
                                @if (Model.Status == 0)
                                {
                                    <span class="badge bg-warning">Chờ duyệt</span>
                                }
                                else if (Model.Status == 1)
                                {
                                    <span class="badge bg-info">Đang giao</span>
                                }
                                else if (Model.Status == 2)
                                {
                                    <span class="badge bg-success">Đã giao</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Đã hủy</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th>Ghi chú:</th>
                            <td>@(Model.Notes ?? "Không có ghi chú")</td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <i class="fas fa-user"></i> Thông tin khách hàng
                </div>
                <div class="card-body">
                    <table class="table table-borderless">
                        <tr>
                            <th style="width: 100px;">Họ tên:</th>
                            <td>@(Model.Customer?.FullName ?? "N/A")</td>
                        </tr>
                        <tr>
                            <th>Email:</th>
                            <td>@(Model.Customer?.Email ?? "N/A")</td>
                        </tr>
                        <tr>
                            <th>Điện thoại:</th>
                            <td>@(Model.Customer?.Phone ?? "N/A")</td>
                        </tr>
                        <tr>
                            <th>Địa chỉ:</th>
                            <td>@(Model.Customer?.Address ?? "N/A")</td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Danh sách sản phẩm trong đơn -->
    <div class="card">
        <div class="card-header bg-success text-white">
            <i class="fas fa-boxes"></i> Danh sách sản phẩm
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th>Sản phẩm</th>
                            <th>Đơn giá</th>
                            <th>Số lượng</th>
                            <th>Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.OrderDetails != null && Model.OrderDetails.Any())
                        {
                            foreach (var item in Model.OrderDetails)
                            {
                                <tr>
                                    <td>@(item.Product?.Name ?? "N/A")</td>
                                    <td>@String.Format("{0:N0} VNĐ", item.UnitPrice)</td>
                                    <td>@item.Quantity</td>
                                    <td class="text-danger fw-bold">@String.Format("{0:N0} VNĐ", item.UnitPrice * item.Quantity)</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted">Không có sản phẩm nào</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-dark">
                        <tr>
                            <th colspan="3" class="text-end">Tổng cộng:</th>
                            <th class="text-danger">@String.Format("{0:N0} VNĐ", Model.TotalAmount)</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-4">
        @if (User.IsInRole("Administrator"))
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                <i class="fas fa-edit"></i> Sửa đơn hàng
            </a>
        }
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-list"></i> Quay lại danh sách
        </a>
    </div>
</div>