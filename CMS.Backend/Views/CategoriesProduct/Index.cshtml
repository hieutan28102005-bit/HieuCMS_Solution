@model List<CMS.Data.Entities.CategoryProduct>

<div class="container-fluid mt-4" style="font-family: Arial, sans-serif;">
    @{
        var error = TempData["Error"] as string;
    }

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger" role="alert" style="font-weight: 600;">
            @error
        </div>
    }

    <h1 class="mb-3" style="color: #333; font-weight: bold;">DANH SÁCH DANH MỤC SẢN PHẨM</h1>

    <p>
        <a href="/CategoryProduct/Create" class="btn btn-primary" style="background-color: #007bff; border-color: #007bff; font-weight: bold; padding: 8px 16px; text-decoration: none; border-radius: 4px; display: inline-block;">
            + Thêm danh mục mới
        </a>
    </p>

    <div class="table-responsive">
        <table class="table table-bordered table-striped" style="border-collapse: collapse; width: 100%; box-shadow: 0 2px 5px rgba(0,0,0,0.05); font-size: 14px;">
            <thead>
                <tr style="background-color: #007bff; color: white; border-color: #007bff; text-align: left;">
                    <th style="padding: 12px; width: 80px;">ID</th>
                    <th style="padding: 12px;">Tên danh mục</th>
                    <th style="padding: 12px; width: 150px; text-align: center;">Chức năng</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr style="vertical-align: middle;">
                            <td style="font-weight: bold; padding: 12px;">@item.Id</td>
                            <td style="padding: 12px; font-weight: 500;">@item.Name</td>
                            <td style="padding: 12px; text-align: center;">
                                <a href="/CategoryProduct/Edit/@item.Id" class="text-primary" style="text-decoration: none; font-weight: bold; margin-right: 15px;">Sửa</a>

                                @if (User.IsInRole("Admin"))
                                {
                                    <a href="/CategoryProduct/Delete/@item.Id"
                                       onclick="return confirm('Bạn có chắc chắn muốn xóa danh mục này?')"
                                       class="text-danger" style="text-decoration: none; font-weight: bold;">Xóa</a>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center p-4 text-muted" style="background-color: #f9f9f9;">
                            Không có dữ liệu danh mục nào.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
