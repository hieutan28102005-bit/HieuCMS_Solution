@{
    ViewData["Title"] = "Hồ sơ cá nhân";
}

<div class="card-custom">
    <div class="d-flex align-items-center mb-4">
        <div class="flex-shrink-0">
            <div class="bg-gradient-primary p-3 rounded-circle" style="background: linear-gradient(135deg, #3b82f6, #8b5cf6); width: 80px; height: 80px; display: flex; align-items: center; justify-content: center;">
                <i class="fas fa-user fa-3x text-white"></i>
            </div>
        </div>
        <div class="flex-grow-1 ms-4">
            <h2 class="mb-1">@(ViewBag.FullName ?? ViewBag.Username ?? "Người dùng")</h2>
            <p class="text-muted mb-0">
                <i class="fas fa-envelope"></i> @ViewBag.Username
            </p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <i class="fas fa-info-circle"></i> Thông tin tài khoản
                </div>
                <div class="card-body">
                    <table class="table table-borderless">
                        <tr>
                            <th style="width: 120px;">Tên đăng nhập:</th>
                            <td>@ViewBag.Username</td>
                        </tr>
                        <tr>
                            <th>Họ và tên:</th>
                            <td>@(ViewBag.FullName ?? "Chưa cập nhật")</td>
                        </tr>
                        <tr>
                            <th>Vai trò:</th>
                            <td>
                                @if (ViewBag.Role == "Administrator")
                                {
                                    <span class="badge bg-danger">
                                        <i class="fas fa-shield-alt"></i> Quản trị viên
                                    </span>
                                }
                                else if (ViewBag.Role == "Editor")
                                {
                                    <span class="badge bg-warning text-dark">
                                        <i class="fas fa-edit"></i> Biên tập viên
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        <i class="fas fa-user"></i> Thành viên
                                    </span>
                                }
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <i class="fas fa-cog"></i> Thao tác
                </div>
                <div class="card-body">
                    <a href="/Account/Logout" class="btn btn-danger w-100 mb-2">
                        <i class="fas fa-sign-out-alt"></i> Đăng xuất
                    </a>
                    <a href="/Home" class="btn btn-secondary w-100">
                        <i class="fas fa-arrow-left"></i> Quay lại Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>