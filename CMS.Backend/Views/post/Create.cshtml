@model CMS.Data.Entities.Post

<!DOCTYPE html>
<html>
<head>
    <title>Thêm bài viết</title>

    <style>

        body {
            font-family: Arial;
            background: #f5f5f5;
            padding: 30px;
        }

        .container {
            width: 500px;
            margin: auto;
            background: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 0 10px #ccc;
        }

        h1 {
            text-align: center;
            margin-bottom: 25px;
        }

        label {
            font-weight: bold;
        }

        input {
            width: 100%;
            padding: 10px;
            margin-top: 5px;
            margin-bottom: 15px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }

        .btn-save {
            background: #28a745;
            color: white;
            border: none;
            padding: 12px;
            width: 100%;
            border-radius: 5px;
            cursor: pointer;
            font-size: 16px;
        }

            .btn-save:hover {
                background: #218838;
            }

        .btn-back {
            display: inline-block;
            margin-top: 15px;
            text-decoration: none;
            color: #007bff;
        }

    </style>

</head>

<body>

    <div class="container">

        <h1>THÊM BÀI VIẾT</h1>

        <form method="post">

            <label>Tiêu đề</label>
            <input type="text" name="Title" />

            <label>Nội dung</label>
            <input type="text" name="Content" />

            <label>Hình ảnh</label>
            <input type="text" name="ImageUrl" />

            <label>Danh mục (CategoryId)</label>
            <input type="number" name="CategoryId" />

            <button class="btn-save" type="submit">
                Thêm bài viết
            </button>

        </form>

        <a class="btn-back" href="/Post">
            ← Quay lại danh sách
        </a>

    </div>

</body>
</html>