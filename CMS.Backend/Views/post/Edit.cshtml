@model CMS.Data.Entities.Post

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Sửa bài viết</title>

    <style>
        body {
            font-family: Arial;
            background: #f5f5f5;
            padding: 30px;
        }

        .container {
            width: 650px;
            margin: auto;
            background: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 0 10px #ccc;
        }

        h1 {
            text-align: center;
            margin-bottom: 25px;
        }

        label {
            font-weight: bold;
        }

        input, select {
            width: 100%;
            padding: 10px;
            margin-top: 5px;
            margin-bottom: 15px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }

        textarea {
            width: 100%;
            border: 1px solid #ccc;
            border-radius: 5px;
            margin-top: 5px;
            margin-bottom: 15px;
            padding: 10px;
            min-height: 180px;
        }

        .btn-save {
            background: #28a745;
            color: white;
            border: none;
            padding: 12px;
            width: 100%;
            border-radius: 5px;
            cursor: pointer;
            font-size: 16px;
        }

            .btn-save:hover {
                background: #218838;
            }

        .btn-back {
            display: inline-block;
            margin-top: 15px;
            text-decoration: none;
            color: #007bff;
        }

        .img-preview {
            margin: 10px 0 15px;
        }
    </style>

    <!-- CKEditor 5 (CDN) -->
    <script src="https://cdn.ckeditor.com/ckeditor5/39.0.1/classic/ckeditor.js"></script>
</head>

<body>
    <div class="container">
        <h1>SỬA BÀI VIẾT</h1>

        <form asp-action="Edit" asp-controller="Post" method="post" enctype="multipart/form-data" asp-antiforgery="true">
            <input type="hidden" asp-for="Id" />

            <div>
                <label asp-for="Title">Tiêu đề</label>
                <input asp-for="Title" />
            </div>

            <div>
                <label asp-for="Content">Nội dung</label>
                <textarea asp-for="Content" id="Content"></textarea>
            </div>

            <div>
                <label>Hình ảnh hiện tại</label>
                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <div class="img-preview">
                        <img src="@Model.ImageUrl" alt="Ảnh" style="max-width: 250px; height: auto;" />
                    </div>
                }
                <label>Chọn ảnh mới (nếu muốn thay)</label>
                <input type="file" name="ImageFile" accept="image/*" />
            </div>

            <div>
                <label asp-for="CategoryId">Danh mục</label>
                <select asp-for="CategoryId" asp-items="ViewBag.Categories">
                    <option value="">-- Chọn danh mục --</option>
                </select>
            </div>

            <button class="btn-save" type="submit">Lưu</button>
            <a class="btn-back" href="/Post">← Quay lại danh sách</a>
        </form>
    </div>

    <script>
        ClassicEditor
            .create(document.querySelector('#Content'), {})
            .catch(error => console.error(error));
    </script>
</body>
</html>
