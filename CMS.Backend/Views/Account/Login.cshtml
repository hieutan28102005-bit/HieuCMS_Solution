@model CMS.Backend.Models.LoginViewModel

@{
    Layout = null; // Trang độc lập không dùng chung Sidebar
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng Nhập Hệ Thống CMS</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body style="background-color: #f4f6f9; font-family: Arial, sans-serif;">

    <div class="container d-flex justify-content-center align-items-center" style="min-height: 100vh;">
        <div class="card shadow-sm" style="width: 100%; max-width: 400px; border-radius: 8px;">
            <div class="card-header text-center text-white p-3" style="background-color: #007bff;">
                <h4 class="mb-0" style="font-weight: bold; letter-spacing: 1px;">HỆ THỐNG CMS</h4>
            </div>
            <div class="card-body p-4">
                <form action="/Account/Login" method="post">
                    @Html.AntiForgeryToken()

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger p-2" style="font-size: 14px;">
                            @Html.ValidationSummary(true, "")
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label font-weight-bold text-secondary">Tài khoản (Email/Username):</label>
                        <input asp-for="Email" class="form-control" placeholder="admin hoặc editor01..." required />
                        <span asp-validation-for="Email" class="text-danger" style="font-size: 12px;"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label font-weight-bold text-secondary">Mật khẩu:</label>
                        <input asp-for="Password" class="form-control" placeholder="Nhập mật khẩu..." required />
                        <span asp-validation-for="Password" class="text-danger" style="font-size: 12px;"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 p-2" style="background-color: #007bff; border: none; font-weight: bold;">
                        ĐĂNG NHẬP
                    </button>
                </form>
                <div class="mt-3 text-center text-muted" style="font-size: 12px;">
                    Tài khoản test: <b>admin</b> (Admin) / <b>editor01</b> (User) (Mật khẩu: 123456)
                </div>
            </div>
        </div>
    </div>

</body>
</html>
