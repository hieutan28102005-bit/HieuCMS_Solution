@model CMS.Data.Entities.User

<h1>Thêm thành viên</h1>

<form method="post">

    <p>Tên đăng nhập</p>
    <input type="text" name="Username" />

    <p>Họ và tên</p>
    <input type="text" name="FullName" />

    <p>Quyền hạn</p>
    <input type="text" name="Role" />

    <br />
    <br />

    <button type="submit">Thêm</button>

</form>