@model List<CMS.Data.Entities.User>

@{
    ViewData["Title"] = "Quản lý thành viên";
}

<div class="container-fluid">
    <h2 class="mb-4">QUẢN LÝ THÀNH VIÊN</h2>

    <a class="btn btn-success mb-3" asp-controller="User" asp-action="Create">
        + Thêm thành viên mới
    </a>

    <table class="table table-hover table-bordered shadow-sm bg-white">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Tên đăng nhập</th>
                <th>Họ và tên</th>
                <th>Quyền hạn</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Username</td>
                    <td>@item.FullName</td>
                    <td>
                        @if (item.Role == "Administrator")
                        {
                            <span class="badge bg-danger">@item.Role</span>
                        }
                        else if (item.Role == "Editor")
                        {
                            <span class="badge bg-primary">@item.Role</span>
                        }
                        else
                        {
                            <span class="badge bg-info text-dark">@item.Role</span>
                        }
                    </td>
                    <td>
                        <a class="btn btn-sm btn-warning" asp-controller="User" asp-action="Edit" asp-route-id="@item.Id">Sửa</a>
                        <a class="btn btn-sm btn-danger" asp-controller="User" asp-action="Delete" asp-route-id="@item.Id"
                           onclick="return confirm('Bạn có chắc chắn muốn xóa thành viên này?')">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>